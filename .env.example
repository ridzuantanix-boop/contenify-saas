# ==============================================================================
# CONTENIFY — Environment Configuration Template
# Strictly sanitized. NEVER commit actual production secrets to Git or chat.
# ==============================================================================

# APP RUNTIME
NODE_ENV=development
DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
USE_MOCK_PROVIDERS=true

# DATABASE (Supabase / PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# STORAGE (Cloudflare R2 Private Bucket)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=contenify-private-assets
R2_PUBLIC_DOMAIN=https://assets.contenify.internal

# AI VIDEO PROVIDER 1: NEXABOT (15s i2v Voice; release flags remain OFF)
NEXABOT_API_KEY=your_nexabot_api_key_here
NEXABOT_BASE_URL=https://nexabot.id
AFFIMATIK_VOICE_PUBLIC_ENABLED=false

# AI VIDEO PROVIDER 2: RUNNINGHUB (historical compatibility only; public disabled in code)
RUNNINGHUB_API_KEY=your_runninghub_api_key_here
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_WEBAPP_ID=2103149871766220801
AFFIMATIK_MOTION_PUBLIC_ENABLED=false
PUBLIC_CHECKOUT_ENABLED=false

# PAYMENT & BILLING (Stripe / Local FPX)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
